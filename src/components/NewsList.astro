---
import { news } from "../data/news";
import type { Locale } from "../i18n/routes";

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit } = Astro.props;
const sortedNews = news.slice().sort((a, b) => b.date.localeCompare(a.date));
const visibleNews =
  typeof limit === "number" ? sortedNews.slice(0, limit) : sortedNews;
const formatDate = (value: string) => {
  const [year, month, day] = value.split("-").map(Number);
  const date = new Date(Date.UTC(year, (month ?? 1) - 1, day ?? 1));
  return new Intl.DateTimeFormat(locale === "en" ? "en-US" : "zh-CN", {
    year: "numeric",
    month: month ? (day ? "short" : "long") : undefined,
    day: day ? "numeric" : undefined,
    timeZone: "UTC",
  }).format(date);
};
---

<ol class="news-list">
  {
    visibleNews.map((item) => {
      const href =
        locale === "zh" && "related_link_zh" in item
          ? item.related_link_zh
          : item.related_link;
      const isExternal = href.startsWith("http");
      return (
        <li>
          <time datetime={item.date}>{formatDate(item.date)}</time>
          <a
            href={href}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {locale === "en" ? item.title_en : item.title_zh}
          </a>
        </li>
      );
    })
  }
</ol>
