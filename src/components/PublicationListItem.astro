---
import type { CollectionEntry } from "astro:content";
import { dictionaries, type Locale } from "../i18n/routes";
import CopyBibtexButton from "./CopyBibtexButton.astro";
import MediaLightbox from "./MediaLightbox.astro";

interface Props {
  publication: CollectionEntry<"publications">["data"];
  locale: Locale;
}

const { publication, locale } = Astro.props;
const t = dictionaries[locale];
const filterText =
  `${publication.title} ${publication.authors.map((author) => author.name).join(" ")} ${publication.venue}`.toLowerCase();
const statusLabels: Record<string, string> = {
  Published: locale === "en" ? "Published" : "已发表",
  Accepted: locale === "en" ? "Accepted" : "已接收",
  "In Press": locale === "en" ? "In Press" : "在线优先",
  Preprint: locale === "en" ? "Preprint" : "预印本",
  "Under Review": locale === "en" ? "Under Review" : "在投",
};
const venue =
  locale === "zh" && publication.venue === "Manuscript under review"
    ? "在投稿件"
    : publication.venue;
const metricBadges = publication.venue_metrics
  ? locale === "en"
    ? publication.venue_metrics.badges_en
    : publication.venue_metrics.badges_zh
  : [];
const metricNote = publication.venue_metrics
  ? locale === "en"
    ? publication.venue_metrics.note_en
    : publication.venue_metrics.note_zh
  : undefined;
---

<article
  id={`list-${publication.id}`}
  class="publication-list-item"
  data-publication
  data-year={publication.year}
  data-status={publication.status}
  data-topics={publication.topics.join(" ")}
  data-search={filterText}
>
  <div class="publication-list-visual">
    <MediaLightbox
      id={`list-${publication.id}-${locale}`}
      src={publication.image.src}
      alt={locale === "en"
        ? publication.image.alt_en
        : publication.image.alt_zh}
      label={`${t.labels.openImage}: ${publication.title}`}
      closeLabel={t.labels.close}
      className="publication-image-button"
    />
    <span class="figure-source-badge">
      {
        locale === "en"
          ? publication.image.label_en
          : publication.image.label_zh
      }
    </span>
    <span class="publication-year">{publication.year}</span>
  </div>
  <div class="publication-list-content">
    <div class="badge-row">
      <span
        class={`status-badge status-${publication.status.toLowerCase().replace(" ", "-")}`}
        >{statusLabels[publication.status]}</span
      >
      {
        publication.co_first_author && (
          <span class="author-badge">{t.labels.coFirstAuthor}</span>
        )
      }
      {
        !publication.co_first_author && publication.first_author && (
          <span class="author-badge">{t.labels.firstAuthor}</span>
        )
      }
      {
        metricBadges.map((badge) => (
          <span class="metric-badge" title={metricNote}>
            {badge}
          </span>
        ))
      }
    </div>
    <h3>{publication.title}</h3>
    <p class="authors">
      {
        publication.authors.map((author, index) => (
          <>
            {author.self ? (
              <strong class="author-self">{author.name}</strong>
            ) : (
              <span>{author.name}</span>
            )}
            {author.equal_contribution && (
              <sup title={t.labels.equalContribution}>†</sup>
            )}
            {index < publication.authors.length - 1 ? ", " : ""}
          </>
        ))
      }
    </p>
    <p class="venue-line">
      <strong>{venue}</strong>{
        publication.volume && ` · ${publication.volume}`
      }{publication.issue && `(${publication.issue})`}{
        publication.pages && ` · ${publication.pages}`
      }{publication.article_number && ` · ${publication.article_number}`}
    </p>
    {
      publication.doi && (
        <p class="doi">
          <span>{t.labels.doi}</span>
          <a
            href={publication.links.paper ?? undefined}
            target="_blank"
            rel="noopener noreferrer"
          >
            {publication.doi}
          </a>
        </p>
      )
    }
    <div class="button-row compact-row">
      {
        publication.links.paper && (
          <a
            class="button mini primary"
            href={publication.links.paper}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.labels.paper}
          </a>
        )
      }
      {
        publication.links.code && (
          <a
            class="button mini secondary"
            href={publication.links.code}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.labels.code}
          </a>
        )
      }
      {
        publication.links.project && (
          <a class="button mini ghost" href={publication.links.project}>
            {t.labels.project}
          </a>
        )
      }
      <CopyBibtexButton
        id={`list-${publication.id}`}
        title={publication.title}
        bibtex={publication.bibtex}
        {locale}
      />
    </div>
  </div>
</article>
