---
import { biography, profile } from "../data/profile";
import { dictionaries, pathFor, type Locale } from "../i18n/routes";
import SocialLinks from "./SocialLinks.astro";
import Supervisors from "./Supervisors.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionaries[locale];
---

<section class="hero-section" aria-labelledby="profile-name">
  <div class="container hero-grid">
    <img
      class="hero-portrait"
      src={profile.avatar}
      alt={locale === "en" ? profile.avatarAlt : profile.avatarAltZh}
      width="112"
      height="112"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-copy">
      <h1 id="profile-name">
        <span>{locale === "en" ? profile.name : profile.chineseName}</span>
        <span lang={locale === "en" ? "zh-CN" : "en"}>
          {locale === "en" ? profile.chineseName : profile.name}
        </span>
      </h1>
      <div class="hero-role">
        <p>
          {locale === "en" ? profile.position : profile.positionZh} · {
            locale === "en" ? "Biomedical Engineering" : "生物医学工程"
          }
        </p>
        <p>{locale === "en" ? profile.institution : profile.institutionZh}</p>
      </div>
      <p class="hero-supervisors">
        {t.labels.supervisor}{locale === "en" ? ": " : "："}<Supervisors
          {locale}
        />
      </p>
      <p class="hero-summary">
        {locale === "en" ? biography.shortEn : biography.shortZh}
      </p>
      <a class="hero-email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="hero-links">
        <SocialLinks />
        <a href={pathFor(locale, "cv")}>{locale === "en" ? "CV" : "简历"}</a>
      </div>
    </div>
  </div>
</section>
