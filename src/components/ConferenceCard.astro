---
import type { conferences } from "../data/conferences";
import type { Locale } from "../i18n/routes";

interface Props {
  conference: (typeof conferences)[number];
  locale: Locale;
}

const { conference, locale } = Astro.props;
const name = locale === "en" ? conference.name_en : conference.name_zh;
const dates = locale === "en" ? conference.dates_en : conference.dates_zh;
const location =
  locale === "en" ? conference.location_en : conference.location_zh;
const summary = locale === "en" ? conference.summary_en : conference.summary_zh;
const formats = locale === "en" ? conference.formats_en : conference.formats_zh;
const presentation =
  locale === "en" ? conference.presentation_en : conference.presentation_zh;
const award = locale === "en" ? conference.award_en : conference.award_zh;
---

<article class="conference-card" id={conference.id}>
  <figure class="conference-image">
    <img
      src={conference.image.src}
      alt={locale === "en" ? conference.image.alt_en : conference.image.alt_zh}
      width="1200"
      height="750"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="conference-content">
    <div
      class="conference-formats"
      aria-label={locale === "en" ? "Participation formats" : "参会形式"}
    >
      {formats.map((format) => <span>{format}</span>)}
    </div>
    <h3>{name}</h3>
    <p class="conference-meta">{dates} · {location}</p>
    <p>{summary}</p>
    <div class="conference-talk">
      <strong>{locale === "en" ? "Presentation" : "报告内容"}</strong>
      <span>{presentation}</span>
    </div>
    {
      award && (
        <p class="conference-award">
          <span aria-hidden="true">★</span> {award}
        </p>
      )
    }
    {
      conference.official_url && (
        <a
          class="conference-link"
          href={conference.official_url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {locale === "en" ? "Conference website" : "会议官网"}
        </a>
      )
    }
  </div>
</article>
