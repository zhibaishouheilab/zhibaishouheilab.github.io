---
import type { Locale } from "../i18n/routes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const filters = [
  { value: "all", en: "All", zh: "全部" },
  { value: "oral", en: "Oral", zh: "口头汇报" },
  { value: "poster", en: "Poster", zh: "海报" },
];
---

<div
  class="presentation-filters"
  role="group"
  aria-label={locale === "en"
    ? "Filter presentations by format"
    : "按展示形式筛选"}
  data-presentation-filters
>
  {
    filters.map((filter, index) => (
      <button
        class="button mini ghost"
        type="button"
        aria-pressed={index === 0 ? "true" : "false"}
        data-presentation-filter={filter.value}
      >
        {locale === "en" ? filter.en : filter.zh}
      </button>
    ))
  }
</div>
<p class="filter-summary" aria-live="polite" data-presentation-summary></p>

<script>
  const filterRoot = document.querySelector<HTMLElement>(
    "[data-presentation-filters]",
  );
  const presentationItems = Array.from(
    document.querySelectorAll<HTMLElement>("[data-presentation]"),
  );
  const summary = document.querySelector<HTMLElement>(
    "[data-presentation-summary]",
  );
  filterRoot
    ?.querySelectorAll<HTMLButtonElement>("button")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.presentationFilter ?? "all";
        filterRoot.querySelectorAll("button").forEach((candidate) => {
          candidate.setAttribute("aria-pressed", String(candidate === button));
        });
        let visible = 0;
        presentationItems.forEach((item) => {
          const matches =
            filter === "all" || item.dataset.formats?.includes(filter);
          item.hidden = !matches;
          if (matches) visible += 1;
        });
        if (summary) summary.textContent = String(visible);
      });
    });
  if (summary) summary.textContent = String(presentationItems.length);
</script>
