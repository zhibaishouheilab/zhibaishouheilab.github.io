---
import { getCollection } from "astro:content";
import ContentLayout from "../layouts/ContentLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { pathFor, type RouteName } from "../i18n/routes";

const locale = "en" as const;
const publications = (await getCollection("publications")).map(
  (entry) => entry.data,
);
const projectOrder = [
  "cervical-spine-ai",
  "vertebral-fracture-assessment",
  "medical-anomaly-detection",
];
const projects = (await getCollection("projects"))
  .map((entry) => entry.data)
  .sort((a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id));
const publicationById = new Map(
  publications.map((publication) => [publication.id, publication]),
);
const detailRoutes: Record<string, RouteName> = {
  "cervical-spine-ai": "researchCervical",
  "vertebral-fracture-assessment": "researchVertebral",
  "medical-anomaly-detection": "researchAnomaly",
};
---

<ContentLayout
  {locale}
  routeName="research"
  eyebrow="Research"
  heading="Current research"
  intro="My current work focuses on cervical spine imaging, interpretable vertebral-fracture assessment, and medical anomaly detection."
  title="Research | Qi Zhang"
  description="Research projects by Qi Zhang in cervical spine imaging, vertebral-fracture assessment, and medical anomaly detection."
>
  <section class="section">
    <div class="container projects-stack">
      {
        projects.map((project) => (
          <ProjectCard
            {project}
            {locale}
            detailUrl={pathFor(locale, detailRoutes[project.id])}
            relatedPublications={project.related_publications
              .map((id) => publicationById.get(id))
              .filter((publication) => Boolean(publication))
              .map((publication) => ({
                id: publication!.id,
                year: publication!.year,
                title: publication!.title,
                status: publication!.status,
                paper: publication!.links.paper,
                code: publication!.links.code,
              }))}
          />
        ))
      }
    </div>
  </section>

  <section class="section soft-teal">
    <div class="container content-narrow">
      <p class="eyebrow">Next steps</p>
      <h2 style="margin-top: .6rem;">From images to quantitative assessment</h2>
      <div class="prose" style="margin-top: 1rem;">
        <p>
          I am extending these projects toward multimodal cervical imaging,
          isotropic 3D reconstruction, structured quantitative analysis, and
          uncertainty-aware review.
        </p>
      </div>
    </div>
  </section>
</ContentLayout>
