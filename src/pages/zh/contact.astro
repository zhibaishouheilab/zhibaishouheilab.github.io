---
import ContentLayout from "../../layouts/ContentLayout.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import Supervisors from "../../components/Supervisors.astro";
import { profile } from "../../data/profile";
import { dictionaries } from "../../i18n/routes";

const locale = "zh" as const;
const t = dictionaries[locale];
---

<ContentLayout
  {locale}
  routeName="contact"
  eyebrow="联系"
  heading="联系"
  intro="欢迎就颈椎影像、医学异常检测、定量影像及面向临床的可靠评估开展研究交流与合作。"
  title="联系 | 张琦"
  description="张琦在上海交通大学的联系方式与学术主页链接。"
>
  <section class="section">
    <div class="container content-narrow">
      <dl class="fact-grid">
        <div>
          <dt>{t.labels.primaryEmail}</dt><dd>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </dd>
        </div>
        <div>
          <dt>{t.labels.alternativeEmail}</dt><dd>
            <a href={`mailto:${profile.alternativeEmail}`}
              >{profile.alternativeEmail}</a
            >
          </dd>
        </div>
        <div>
          <dt>{t.labels.institution}</dt><dd>
            <a
              href={profile.institutionUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {profile.institutionZh}
            </a><br />
            <a
              href={profile.departmentUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {profile.departmentZh}
            </a>
          </dd>
        </div>
        <div><dt>{t.labels.location}</dt><dd>{profile.locationZh}</dd></div>
        <div>
          <dt>{t.labels.supervisor}</dt><dd>
            <Supervisors {locale} />
          </dd>
        </div>
      </dl>
      <div style="margin-top: 2rem;"><SocialLinks /></div>
    </div>
  </section>
</ContentLayout>
