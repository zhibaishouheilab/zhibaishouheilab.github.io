---
import ContentLayout from "../../layouts/ContentLayout.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { profile } from "../../data/profile";
import { dictionaries } from "../../i18n/routes";

const locale = "zh" as const;
const t = dictionaries[locale];
---

<ContentLayout
  {locale}
  routeName="contact"
  eyebrow="联系"
  heading="科研交流与合作"
  intro="如需讨论已发表工作、可复现性或科研合作，建议优先使用校内邮箱联系。"
  title="联系 | 张琦"
  description="张琦在上海交通大学的联系方式与学术主页链接。"
>
  <section class="section">
    <div class="container content-narrow">
      <dl class="fact-grid">
        <div>
          <dt>{t.labels.primaryEmail}</dt><dd>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </dd>
        </div>
        <div>
          <dt>{t.labels.alternativeEmail}</dt><dd>
            <a href={`mailto:${profile.alternativeEmail}`}
              >{profile.alternativeEmail}</a
            >
          </dd>
        </div>
        <div>
          <dt>{t.labels.institution}</dt><dd>
            {profile.institutionZh}<br />{profile.departmentZh}
          </dd>
        </div>
        <div><dt>{t.labels.location}</dt><dd>{profile.locationZh}</dd></div>
        <div><dt>{t.labels.supervisor}</dt><dd>{profile.supervisorZh}</dd></div>
      </dl>
      <div style="margin-top: 2rem;"><SocialLinks /></div>
    </div>
  </section>
</ContentLayout>
