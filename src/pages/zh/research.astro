---
import { getCollection } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const locale = "zh" as const;
const publications = (await getCollection("publications")).map(
  (entry) => entry.data,
);
const projectOrder = [
  "cervical-spine-ai",
  "vertebral-fracture-assessment",
  "medical-anomaly-detection",
];
const projects = (await getCollection("projects"))
  .map((entry) => entry.data)
  .sort((a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id));
const publicationTitle = new Map(
  publications.map((publication) => [publication.id, publication.title]),
);
---

<ContentLayout
  {locale}
  routeName="research"
  eyebrow="研究"
  heading="当前研究"
  intro="目前主要开展颈椎影像、可解释椎体骨折评估与医学异常检测研究。"
  title="研究 | 张琦"
  description="张琦在颈椎影像、椎体骨折评估与医学异常检测方向的研究项目。"
>
  <section class="section">
    <div class="container projects-stack">
      {
        projects.map((project) => (
          <ProjectCard
            {project}
            {locale}
            relatedTitles={project.related_publications
              .map((id) => publicationTitle.get(id))
              .filter((title): title is string => Boolean(title))}
          />
        ))
      }
    </div>
  </section>

  <section class="section soft-teal">
    <div class="container content-narrow">
      <p class="eyebrow">下一步工作</p><h2 style="margin-top: .6rem;">
        从医学图像到定量评估
      </h2>
      <div class="prose" style="margin-top: 1rem;">
        <p>
          我正在将这些研究拓展到多模态颈椎影像、各向同性三维重建、结构化定量分析与不确定性感知复核。
        </p>
      </div>
    </div>
  </section>
</ContentLayout>
