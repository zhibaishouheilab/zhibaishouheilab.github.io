---
import ContentLayout from "../../layouts/ContentLayout.astro";
import { biography, profile } from "../../data/profile";
import { education } from "../../data/education";
import HonorsList from "../../components/HonorsList.astro";
import { dictionaries } from "../../i18n/routes";

const locale = "zh" as const;
const t = dictionaries[locale];
---

<ContentLayout
  {locale}
  routeName="about"
  eyebrow="关于"
  heading="面向临床可靠性的医学图像分析"
  intro="我的研究涉及颈椎MRI与CT、医学异常检测、图像重建和定量影像。"
  title="关于张琦 | 医学图像分析"
  description="张琦在上海交通大学的个人简介、教育经历、研究经验与临床合作背景。"
>
  <section class="section">
    <div class="container split-layout">
      <div>
        <p class="eyebrow">{t.labels.biography}</p>
        <div class="prose" style="margin-top: 1rem;">
          {
            biography.longZh
              .split("\n\n")
              .map((paragraph) => <p>{paragraph}</p>)
          }
        </div>
      </div>
      <aside>
        <div class="side-panel">
          <h2>{t.labels.supervisor}</h2><p>
            <a
              href={profile.supervisorUrl}
              target="_blank"
              rel="noopener noreferrer"
              ><strong>{profile.supervisorZh}</strong></a
            ><br />{profile.institutionZh}{profile.departmentZh}
          </p>
        </div>
        <div class="side-panel">
          <h2>{t.labels.clinicalCollaboration}</h2><p>
            目前的主要临床合作单位包括：
          </p>
          <ul class="collaboration-list">
            <li>仁济医院脊柱外科</li>
            <li>上海市第六人民医院骨科</li>
            <li>瑞金医院影像科</li>
            <li>仁济医院影像科</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section surface" aria-labelledby="education-heading">
    <div class="container content-narrow">
      <p class="eyebrow">培养经历</p><h2
        id="education-heading"
        style="margin-top: .6rem;"
      >
        {t.labels.education}
      </h2>
      <ol class="timeline" style="margin-top: 1.5rem;">
        {
          education.map((item) => (
            <li>
              <>
                <time>{item.periodZh}</time>
                <div>
                  <>
                    <strong>{item.titleZh}</strong>
                    <span>{item.detailZh}</span>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="honors-heading">
    <div class="container content-narrow">
      <p class="eyebrow">奖励与奖学金</p><h2
        id="honors-heading"
        style="margin-top: .6rem;"
      >
        个人荣誉
      </h2>
      <HonorsList {locale} />
    </div>
  </section>

  <section class="section soft-teal">
    <div class="container content-narrow">
      <p class="eyebrow">当前研究</p><h2 style="margin-top: .6rem;">
        研究兴趣
      </h2>
      <ul class="method-list" aria-label="研究兴趣">
        <li>颈椎MRI与CT</li><li>医学异常检测</li><li>医学图像分割</li><li>
          多模态学习
        </li><li>不确定性估计</li><li>外部验证</li><li>可解释测量</li><li>
          医生介入修正
        </li>
      </ul>
    </div>
  </section>
</ContentLayout>
