---
import { getCollection } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import FeaturedPublicationCard from "../../components/FeaturedPublicationCard.astro";
import PublicationFilters from "../../components/PublicationFilters.astro";
import PublicationListItem from "../../components/PublicationListItem.astro";
import ConferenceCard from "../../components/ConferenceCard.astro";
import { conferences } from "../../data/conferences";
import { dictionaries } from "../../i18n/routes";

const locale = "zh" as const;
const t = dictionaries[locale];
const publications = (await getCollection("publications"))
  .map((entry) => entry.data)
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));
const featured = publications.filter((publication) => publication.featured);
const years = [
  ...new Set(publications.map((publication) => publication.year)),
].sort((a, b) => b - a);
const statuses = [
  ...new Set(publications.map((publication) => publication.status)),
].sort();
const topics = [
  ...new Set(publications.flatMap((publication) => publication.topics)),
].sort();
---

<ContentLayout
  {locale}
  routeName="publications"
  eyebrow="论文"
  heading="论文与学术会议"
  intro="我的研究涉及颈椎影像、医学异常检测、图像重建与定量影像。"
  title="论文 | 张琦"
  description="张琦在医学图像分析、颈椎影像与异常检测方向的论文、在投稿件和学术会议记录。"
>
  <section class="section" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">重点成果</p><h2 id="featured-heading">
            {t.labels.featuredFirstAuthor}
          </h2>
        </div>
        <p>卡片图片选用各篇论文中具有代表性的方法总览或工作流程图。</p>
      </div>
      <div class="featured-grid">
        {
          featured.map((publication) => (
            <FeaturedPublicationCard {publication} {locale} />
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section soft-blue"
    id="conferences"
    aria-labelledby="conferences-heading"
  >
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">学术交流</p><h2 id="conferences-heading">
            参会与报告
          </h2>
        </div>
        <p>2025至2026年的口头汇报、海报展示与会议获奖记录。</p>
      </div>
      <div class="conference-grid">
        {
          conferences.map((conference) => (
            <ConferenceCard {conference} {locale} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section surface" aria-labelledby="all-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">论文列表</p><h2 id="all-heading">
            论文与在投稿件
          </h2>
        </div>
      </div>
      <PublicationFilters {locale} {years} {statuses} {topics} />
      <div class="publication-list" style="margin-top: 1.5rem;">
        {
          publications.map((publication) => (
            <PublicationListItem {publication} {locale} />
          ))
        }
      </div>
    </div>
  </section>
</ContentLayout>
