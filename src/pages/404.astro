---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  routeName="home"
  title="Page not found | Qi Zhang"
  description="The requested page could not be found."
>
  <section class="section">
    <div class="container content-narrow">
      <p class="eyebrow">404</p>
      <h1 style="font-size: clamp(2.6rem, 6vw, 4.5rem); margin-top: .5rem;">
        Page not found
      </h1>
      <p class="page-lead" style="margin-top: 1rem;">
        The page may have moved, or the address may be incomplete. /
        页面不存在或地址已变更。
      </p>
      <div class="button-row" style="margin-top: 1.5rem;">
        <a class="button primary" href="/">Return home</a><a
          class="button secondary"
          href="/zh/">中文首页</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
