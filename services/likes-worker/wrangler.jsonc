{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qi-zhang-homepage-likes",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "durable_objects": {
    "bindings": [
      {
        "name": "HOMEPAGE_LIKES",
        "class_name": "HomepageLikes",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HomepageLikes"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
